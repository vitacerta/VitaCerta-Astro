---
import Image from "astro/components/Image.astro";
import { client } from "../lib/sanity";
import { formatDate } from "../utils/dateFormatter";
const locale = Astro.currentLocale || "pt-BR";

const post = await client.fetch(`
  *[_type == "post" && language == $locale] | order(publishedAt desc, _createdAt desc)[0]{
    title,
    description,
    publishedAt,
    _createdAt,
    "slug": slug.current,
    "image": coalesce(mainImage.asset->url, thumbnail.asset->url, coverUrl),
    "categories": categories[0]->{
      "title": title[_key == $locale][0].value,
      "slug": slug.current
    }
  }
`, { locale });
const displayDate = post?.publishedAt || post?._createdAt;
---

{post ? (
  <section class="section section-demo-post">
    <div class="container grid gap-10">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-4 order-2 lg:order-1 group">
        <div>
          {post.categories && (
            <a href={`/${locale}/blog/${post.categories.slug}`} class="uppercase hover:underline">{post.categories.title}</a>
          )}
          <a href={`/conteudos/${post.slug}`} class="group-hover:underline"><h2 class="h1">{post.title}</h2></a>
        </div>
        <div class="grid gap-4">
          <a href={`/conteudos/${post.slug}`}><p>{post.description}</p></a>
          <div class="flex flex-wrap gap-4 justify-between items-center">
            {displayDate && <p>{formatDate(displayDate)}</p>}
            <a href={`/conteudos/${post.slug}`} class="btn btn-outline rounded-none uppercase">LER MATÉRIA</a>
          </div>
        </div>
      </div>
      {post.image && (
        <div class="order-1 lg:order-2">
          <a href={`/conteudos/${post.slug}`}>
            <Image src={post.image} alt={post.title} width={1600} height={900} format="webp" quality={55} loading="eager" fetchpriority="high" sizes="100vw" class="w-full h-auto aspect-video object-cover" />
          </a>
        </div>
      )}
    </div>
  </section>
) : null}
