---
import Image from "astro/components/Image.astro";
import { client } from "../lib/sanity";
import { formatDate } from "../utils/dateFormatter";
const locale = Astro.currentLocale || "pt-BR";

const featured = await client.fetch(`
  *[_type == "post" && language == $locale && isHomeFeatured == true]
    | order(_updatedAt desc, publishedAt desc, _createdAt desc)[0]{
      title,
      description,
      publishedAt,
      _createdAt,
      "slug": slug.current,
      "image": coalesce(thumbnail.asset->url, mainImage.asset->url, coverUrl),
      "categories": categories[0]->{
        "title": title[_key == $locale][0].value,
        "slug": slug.current
      }
    }
`, { locale });

const fallback = featured ? null : await client.fetch(`
  *[_type == "post" && language == $locale]
    | order(publishedAt desc, _createdAt desc)[0]{
      title,
      description,
      publishedAt,
      _createdAt,
      "slug": slug.current,
      "image": coalesce(thumbnail.asset->url, mainImage.asset->url, coverUrl),
      "categories": categories[0]->{
        "title": title[_key == $locale][0].value,
        "slug": slug.current
      }
    }
`, { locale });

const post = featured || fallback;
const displayDate = post?.publishedAt || post?._createdAt;
---

{post ? (
  <section class="home-featured">
    <div class="home-shell">
      <div class="home-section-heading">
        <div>
          <span>LEITURA EM DESTAQUE</span>
          <h2>Para começar</h2>
        </div>
        <p>Uma seleção editorial para transformar informação em escolhas mais conscientes.</p>
      </div>
      <article class="home-featured-card group">
        {post.image && (
          <a class="home-featured-image" href={`/conteudos/${post.slug}`}>
            <Image src={post.image} alt={post.title} width={1600} height={900} format="webp" quality={65} loading="eager" fetchpriority="high" sizes="(min-width: 900px) 58vw, 100vw" />
          </a>
        )}
        <div class="home-featured-copy">
          {post.categories && (
            <a href={`/${locale}/blog/${post.categories.slug}`} class="home-category">{post.categories.title}</a>
          )}
          <a href={`/conteudos/${post.slug}`}><h3>{post.title}</h3></a>
          <p>{post.description}</p>
          <div class="home-featured-meta">
            {displayDate && <time>{formatDate(displayDate)}</time>}
            <a href={`/conteudos/${post.slug}`} class="home-button home-button-outline">Ler matéria <span aria-hidden="true">→</span></a>
          </div>
        </div>
      </article>
    </div>
  </section>
) : null}
