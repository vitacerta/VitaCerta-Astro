---
import Image from "astro/components/Image.astro";
import { formatDateTime } from "../utils/dateFormatter";
const {
  title,
  description,
  _createdAt,
  publishedAt,
  slug,
  image,
  categories,
} = Astro.props;

const displayDate = publishedAt || _createdAt;
---

<article
  class="group flex-1 grid grid-cols-1 gap-4 p-4 lg:p-10 border
  nth-[2n]:border-t-0
  nth-[2n+1]:border-t-0
  nth-[1]:border-t!
  md:nth-[2]:border-t
  lg:nth-[3]:border-t
  md:nth-[2n+1]:border-t
  md:nth-[n+3]:border-t-0
  md:nth-[2n]:border-l-0
  lg:nth-[2n]:border-l
  lg:nth-[3n]:border-l-0
  lg:nth-[3n+2]:border-l-0
  lg:nth-[n+4]:border-t-0"
>
  <div>
    <div class="flex flex-wrap justify-between gap-4 mb-4">
      <span>{formatDateTime(displayDate)}</span>
      {categories?.title && (
        <span class="uppercase ml-auto btn btn-outline rounded-full py-1 px-4 h-auto">
          {categories.title}
        </span>
      )}
    </div>
    <a href={`/conteudos/${slug}/`} class="mb-auto">
      {image && (
        <Image
          src={image}
          alt={title}
          width="1600"
          height="900"
          format="webp"
          quality={80}
          class="aspect-video object-cover mx-auto h-auto w-full"
        />
      )}

      <h3 class="mb-0 mt-4 group-hover:underline">{title}</h3>
    </a>
  </div>
  <div class="mx-auto lg:mx-0 mt-auto">
    <a href={`/conteudos/${slug}/`}>
      <p>{description}</p>
    </a>
  </div>
</article>
