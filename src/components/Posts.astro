---
import PostCardRow from "../components/PostCardRow.astro";
import { client } from "../lib/sanity";
const locale = Astro.currentLocale || "pt-BR";

const posts = await client.fetch(`
  *[_type == "post" && language == $locale] | order(publishedAt desc, _createdAt desc)[1...7]{
    title,
    description,
    "date": coalesce(publishedAt, _createdAt),
    "slug": slug.current,
    "image": coalesce(thumbnail.asset->url, mainImage.asset->url, coverUrl),
    "categories": categories[0]->{
      "title": title[_key == $locale][0].value,
      "slug": slug.current
    }
  }
`, { locale });
---

{posts.length > 0 ? (
  <section class="home-recent">
    <div class="home-shell">
      <div class="home-section-heading home-section-heading-row">
        <div>
          <span>PUBLICAÇÕES</span>
          <h2>Conteúdos recentes</h2>
        </div>
        <a href="/conteudos/" class="home-text-link">Ver todos <span aria-hidden="true">→</span></a>
      </div>
      <div class="home-recent-list">{posts.map((post) => <PostCardRow {...post} />)}</div>
      <div class="home-recent-action">
        <a href="/conteudos/" class="home-button home-button-primary">Explorar todos os conteúdos</a>
      </div>
    </div>
  </section>
) : null}
