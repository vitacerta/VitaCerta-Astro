---
const { title, description, variant = "default" } = Astro.props;
---

{variant === "home" ? (
  <section class="home-hero">
    <div class="home-shell home-hero-grid">
      <div class="home-hero-copy">
        <p class="home-eyebrow">INFORMAÇÃO PARA DECIDIR MELHOR</p>
        <h1>{title}</h1>
        {description && <p class="home-hero-dek">{description}</p>}
        <div class="home-hero-actions">
          <a class="home-button home-button-primary" href="/conteudos/">Explorar conteúdos</a>
          <a class="home-text-link" href="/sobre/">Conheça nosso compromisso <span aria-hidden="true">→</span></a>
        </div>
      </div>
      <aside class="home-principles" aria-label="Princípios editoriais do VitaCerta">
        <span class="home-principles-number">01</span>
        <h2>Ciência traduzida para a vida real.</h2>
        <p>Fontes apresentadas, linguagem acessível e contexto para você formar a própria opinião.</p>
        <ul>
          <li>Sem venda de produtos</li>
          <li>Sem sensacionalismo</li>
          <li>Com transparência editorial</li>
        </ul>
      </aside>
    </div>
  </section>
) : (
  <section class="section section-hero my-5!">
    <div class="container">
      <h1 class="lead">{title}</h1>
    </div>
  </section>
)}
