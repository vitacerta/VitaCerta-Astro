---
import Image from "astro/components/Image.astro";
import { formatDate } from "../utils/dateFormatter";
const { title, slug, description, date, _createdAt, image, categories } = Astro.props;
const locale = Astro.currentLocale || "pt-BR";
const displayDate = date || _createdAt;
---

<article class="home-post-row group">
  <a class="home-post-image" href={`/conteudos/${slug}`}>
    {image && <Image src={image} alt={title} width={480} height={270} format="webp" quality={55} />}
  </a>
  <div class="home-post-copy">
    <div>
      {categories && (
        <a href={`/${locale}/blog/${categories.slug}`} class="home-category">{categories.title}</a>
      )}
      <a href={`/conteudos/${slug}`}>
        <h3>{title}</h3>
        <p>{description}</p>
      </a>
    </div>
    {displayDate && <time>{formatDate(displayDate)}</time>}
  </div>
  <a class="home-post-arrow" href={`/conteudos/${slug}`} aria-label={`Ler ${title}`}><span aria-hidden="true">↗</span></a>
</article>
