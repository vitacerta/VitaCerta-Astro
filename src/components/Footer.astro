---
import type { HTMLAttributes } from "astro/types";
import config from "@/config";

type Props = {
  noMarginTop?: boolean;
} & HTMLAttributes<"footer">;

const { noMarginTop = false, class: className, ...attrs } = Astro.props;
const currentYear = new Date().getFullYear();
const links = [
  { label: "Sobre", href: "/sobre/" },
  { label: "Contato", href: "/contato/" },
  { label: "Privacidade", href: "/politica-de-privacidade/" },
  { label: "Termos de uso", href: "/termos-de-uso/" },
];
---

<footer
  class:list={["app-layout", { "mt-auto": !noMarginTop }, className]}
  {...attrs}
>
  <div class="border-border mt-12 border-t py-8">
    <div class="flex flex-col gap-6 sm:flex-row sm:items-start sm:justify-between">
      <div class="max-w-md">
        <a href="/" class="font-editorial text-2xl font-semibold">
          {config.site.title}
        </a>
        <p class="text-muted-foreground mt-2 text-sm leading-6">
          Informação clara e responsável para apoiar escolhas melhores sobre
          saúde, alimentação, movimento, mente e longevidade.
        </p>
      </div>

      <nav aria-label="Links institucionais">
        <ul class="flex flex-wrap gap-x-5 gap-y-3 text-sm">
          {
            links.map(link => (
              <li>
                <a class="hover:text-accent" href={link.href}>
                  {link.label}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>
    </div>

    <div class="text-muted-foreground mt-8 flex flex-col gap-2 border-t border-dashed pt-5 text-xs sm:flex-row sm:items-center sm:justify-between">
      <span>© {currentYear} VitaCerta. Todos os direitos reservados.</span>
      <span>Conteúdo informativo. Não substitui orientação profissional.</span>
    </div>
  </div>
</footer>
