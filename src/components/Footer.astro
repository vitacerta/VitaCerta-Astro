---
const today = new Date();
import Logo from "./Logo.astro";
import { menu } from "../consts";

const institutionalLinks = [
  { url: "/privacidade/", title: "PRIVACIDADE" },
  { url: "/termos/", title: "TERMOS DE USO" },
  { url: "/contato/", title: "CONTATO" },
];
---

<footer class="footer bg-black text-white pb-10 pt-5">
  <div class="footer-topline overflow-hidden uppercase flex gap-4 overflow-x-hidden w-full" aria-hidden="true">
    {Array.from({ length: 30 }).map((_) => <span>VITACERTA+++</span>)}
  </div>
  <div class="footer-mdl w-full">
    <div class="container">
      <div class="grid grid-cols-1 md:grid-cols-[1fr_3fr] gap-10">
        <div><Logo /></div>
        <div>
          <p class="mb-4">VitaCerta — Informação baseada em ciência para melhores decisões sobre saúde e qualidade de vida.</p>
          <p class="font-semibold mb-6">A informação é nossa responsabilidade. A escolha é sua.</p>
          <nav class="flex flex-wrap gap-6" aria-label="Navegação principal do rodapé">{menu.map((link) => <a href={link.url} class="hover:underline">{link.title}</a>)}</nav>
          <nav class="flex flex-wrap gap-6 mt-4" aria-label="Informações institucionais">{institutionalLinks.map((link) => <a href={link.url} class="hover:underline">{link.title}</a>)}</nav>
        </div>
      </div>
    </div>
  </div>
  <div class="footer-btm w-full">
    <div class="container grid gap-4">
      <p class="text-xs opacity-70">O conteúdo do VitaCerta tem caráter informativo e educativo e não substitui orientação, diagnóstico ou tratamento realizado por profissionais de saúde.</p>
      <div class="flex flex-wrap gap-4 justify-between items-center">
        <p class="text-xs opacity-50">&copy; {today.getFullYear()} VitaCerta</p>
      </div>
    </div>
  </div>
</footer>
