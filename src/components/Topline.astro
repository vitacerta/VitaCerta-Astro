---
import { client } from "../lib/sanity";
const locale = Astro.currentLocale || "pt-BR";
const highlights = await client.fetch(`
  *[_type == "post" && language == $locale && showInHighlights == true]
    | order(_updatedAt desc, publishedAt desc, _createdAt desc)[0...5]{
      title,
      "slug": slug.current
    }
`, { locale });
---

{highlights.length > 0 ? (
  <section class="home-highlights" aria-label="Conteúdos em destaque">
    <div class="home-shell">
      <div class="home-highlights-track">
        <p class="home-highlights-label"><b>EM DESTAQUE</b></p>
        {highlights.map((post) => (
          <a href={`/conteudos/${post.slug}`}>{post.title}<span aria-hidden="true">↗</span></a>
        ))}
      </div>
    </div>
  </section>
) : null}
