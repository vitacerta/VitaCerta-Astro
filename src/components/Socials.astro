---
const socials = [
  { url: "#", title: "Instagram", icon: "fa-brands fa-instagram" },
  { url: "#", title: "YouTube", icon: "fa-brands fa-youtube" },
];
---

<nav class="flex items-center gap-3 flex-wrap">
  {socials.map((icon) => (
    <a href={icon.url} title={icon.title} class="hover:rotate-12" aria-label={icon.title}>
      <i class={icon.icon} />
    </a>
  ))}
</nav>
