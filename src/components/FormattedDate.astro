---
interface Props {
	date: Date;
}

const { date } = Astro.props;
const isValidDate = date instanceof Date && !Number.isNaN(date.getTime());
---

{isValidDate ? (
<time datetime={date.toISOString()}>
	{
		date.toLocaleDateString('pt-BR', {
			year: 'numeric',
			month: 'long',
			day: '2-digit',
		})
	}
</time>
) : <span>Data não informada</span>}
