---
import { getCollection } from "astro:content";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import Card from "@/components/Card.astro";
import { getSortedPosts } from "@/utils/getSortedPosts";
import { EDITORIAL_CATEGORIES } from "@/data/categories";

export function getStaticPaths() {
  return EDITORIAL_CATEGORIES.map(category => ({
    params: { categoria: category.slug },
    props: { category },
  }));
}

const { category } = Astro.props;
const posts = getSortedPosts(await getCollection("posts")).filter(
  post => post.data.category === category.name
);
---

<Layout title={`${category.name} | VitaCerta`} description={category.description}>
  <Header />
  <main id="main-content" class="app-layout py-10 sm:py-14">
    <header class="border-border mb-10 max-w-3xl border-b pb-8">
      <p class="editorial-kicker">VitaCerta</p>
      <h1 class="mt-3 text-4xl font-semibold sm:text-5xl">{category.name}</h1>
      <p class="text-muted-foreground mt-4 max-w-2xl text-lg leading-8">
        {category.description}
      </p>
    </header>

    {
      posts.length > 0 ? (
        <ul class="grid gap-4 md:grid-cols-2">
          {posts.map(post => <Card variant="h2" {...post} />)}
        </ul>
      ) : (
        <div class="editorial-card max-w-2xl">
          <h2 class="text-2xl font-semibold">Conteúdos em preparação</h2>
          <p class="text-muted-foreground mt-2 leading-7">
            Esta seção já faz parte da estrutura editorial do VitaCerta. Os artigos serão incorporados durante a migração do acervo.
          </p>
        </div>
      )
    }
  </main>
  <Footer />
</Layout>
