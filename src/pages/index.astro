---
import Layout from "../layouts/Base.astro";
import Hero from "../components/Hero.astro";
import Topline from "../components/Topline.astro";
import Demo from "../components/DemoPost.astro";
import Posts from "../components/Posts.astro";
import "../styles/home.css";
---

<Layout
  title="Saúde, Ciência e Qualidade de Vida"
  description="Informação baseada em ciência para melhores decisões sobre saúde e qualidade de vida. Conteúdos sobre nutrição, mente, movimento, longevidade e bem-estar."
  lang="pt-BR"
>
  <div class="editorial-home">
    <Hero
      variant="home"
      title="Saúde com clareza, ciência e contexto."
      description="Informação confiável para entender o corpo, comparar escolhas e tomar decisões mais conscientes — sem alarmismo e sem promessas fáceis."
    />
    <Topline />
    <Demo />
    <Posts />
  </div>
</Layout>
