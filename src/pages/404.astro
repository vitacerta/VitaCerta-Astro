---
import Layout from "../layouts/Base.astro";

---

<Layout title="Página não encontrada">
  <section class="section">
    <div class="container text-center grid gap-4">
      <h1 class="text-5xl lg:text-9xl font-bold">404</h1>
      <p>A página que você procura não foi encontrada.</p>
      <a href="/" class="btn btn-neutral mx-auto shadow-none rounded-none"
        >VOLTAR AO INÍCIO</a
      >
    </div>
  </section>
</Layout>
