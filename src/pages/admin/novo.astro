<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="robots" content="noindex,nofollow" />
    <title>Novo artigo | VitaCerta Admin</title>
    <style>
      :root{--bg:#f4f6f4;--panel:#fff;--text:#1f2f28;--muted:#66736d;--line:#dfe6e1;--brand:#245640;--soft:#e8f0eb;--warn:#8a6220}
      *{box-sizing:border-box} body{margin:0;font-family:Inter,ui-sans-serif,system-ui,-apple-system,BlinkMacSystemFont,"Segoe UI",sans-serif;background:var(--bg);color:var(--text)}
      button,input,select,textarea{font:inherit}.topbar{position:sticky;top:0;z-index:8;background:#fff;border-bottom:1px solid var(--line)}
      .topbar-inner,.main{max-width:1100px;margin:auto;padding-left:20px;padding-right:20px}.topbar-inner{min-height:70px;display:flex;align-items:center;justify-content:space-between;gap:12px}
      .brand{font-size:21px;font-weight:800}.brand small{margin-left:8px;color:var(--muted);font-size:13px;font-weight:500}.btn{border:0;border-radius:10px;padding:11px 15px;font-weight:750;cursor:pointer;text-decoration:none;display:inline-flex;align-items:center;justify-content:center}.btn-primary{background:var(--brand);color:#fff}.btn-secondary{background:#edf1ee;color:var(--text)}.btn-outline{background:#fff;border:1px solid #cdd8d1;color:var(--brand)}
      .main{padding-top:28px;padding-bottom:60px}.breadcrumb{margin-bottom:16px}.breadcrumb a{color:var(--brand);text-decoration:none;font-weight:700}.heading{display:flex;justify-content:space-between;gap:18px;align-items:flex-start;margin-bottom:22px}.heading h1{margin:0 0 5px;font-size:clamp(28px,4vw,38px);letter-spacing:-.04em}.muted{color:var(--muted)}
      .editor-grid{display:grid;grid-template-columns:minmax(0,1fr) 300px;gap:20px}.panel{background:var(--panel);border:1px solid var(--line);border-radius:14px;padding:20px}.field{margin-bottom:18px}.field:last-child{margin-bottom:0}.label{display:block;margin-bottom:7px;font-size:14px;font-weight:750}.hint{margin-top:6px;color:var(--muted);font-size:12px}.control{width:100%;border:1px solid #ccd7d0;border-radius:10px;padding:12px;background:#fff;color:var(--text);outline:none}.control:focus{border-color:var(--brand);box-shadow:0 0 0 3px rgba(36,86,64,.10)}textarea.control{resize:vertical;min-height:90px}.html-editor{min-height:420px;font-family:ui-monospace,SFMono-Regular,Menlo,Monaco,Consolas,monospace;font-size:13px;line-height:1.55}
      .tabs{display:flex;gap:8px;margin-bottom:10px}.tab{border:1px solid var(--line);border-radius:9px;background:#fff;padding:9px 12px;font-weight:750;cursor:pointer}.tab.active{background:var(--soft);border-color:#bdd0c3;color:var(--brand)}.preview-shell{display:none;border:1px solid var(--line);border-radius:12px;background:#fff;overflow:hidden}.preview-shell.active{display:block}.preview-top{padding:10px 14px;border-bottom:1px solid var(--line);background:#fafcfb;color:var(--muted);font-size:12px}.preview-frame{padding:30px;max-width:820px;margin:auto}.preview-frame h1{font-size:36px;line-height:1.12;margin:0 0 16px}.preview-frame h2{font-size:27px;margin-top:34px}.preview-frame h3{font-size:21px;margin-top:26px}.preview-frame p,.preview-frame li{font-size:17px;line-height:1.75}.preview-frame img{max-width:100%;height:auto;border-radius:12px}.preview-frame a{color:#245640}.empty-preview{color:var(--muted);text-align:center;padding:50px 20px}
      .side-title{margin:0 0 14px;font-size:16px}.check{display:flex;gap:10px;align-items:flex-start;margin:12px 0}.check input{margin-top:3px}.status{display:flex;align-items:center;gap:8px;padding:10px 12px;border-radius:10px;background:#fff7e8;color:var(--warn);font-weight:750;font-size:13px}.status-dot{width:8px;height:8px;border-radius:50%;background:#c28b2c}.actions{display:grid;gap:10px;margin-top:18px}.safe-note{margin-top:14px;padding:12px;border-radius:10px;background:#f5f7f5;color:var(--muted);font-size:12px;line-height:1.5}
      .footer-actions{display:flex;gap:10px;justify-content:flex-end;margin-top:20px}.message{display:none;margin-top:14px;padding:12px;border-radius:10px;background:#eef4ef;color:#31563f;font-size:13px}.message.show{display:block}
      @media(max-width:820px){.editor-grid{grid-template-columns:1fr}.heading{flex-direction:column}.topbar-inner,.main{padding-left:14px;padding-right:14px}.preview-frame{padding:20px}.preview-frame h1{font-size:30px}.footer-actions{flex-direction:column-reverse}.footer-actions .btn{width:100%}}
    </style>
  </head>
  <body>
    <header class="topbar">
      <div class="topbar-inner">
        <div class="brand">VitaCerta <small>Admin</small></div>
        <a class="btn btn-secondary" href="/admin/">← Artigos</a>
      </div>
    </header>

    <main class="main">
      <div class="breadcrumb"><a href="/admin/">Artigos</a> <span class="muted">/ Novo artigo</span></div>
      <div class="heading">
        <div><h1>Novo artigo</h1><div class="muted">Cole o HTML, visualize como artigo e só depois publique.</div></div>
      </div>

      <div class="editor-grid">
        <section class="panel">
          <div class="field"><label class="label" for="title">Título</label><input class="control" id="title" type="text" placeholder="Título do artigo" /></div>
          <div class="field"><label class="label" for="slug">Slug</label><input class="control" id="slug" type="text" placeholder="gerado-automaticamente-pelo-titulo" /><div class="hint">Gerado automaticamente; pode ser ajustado antes da publicação.</div></div>
          <div class="field"><label class="label" for="description">Resumo / descrição</label><textarea class="control" id="description" maxlength="300" placeholder="Resumo curto usado em cards e SEO"></textarea><div class="hint"><span id="descriptionCount">0</span>/300 caracteres</div></div>
          <div class="field"><label class="label" for="category">Categoria</label><select class="control" id="category"><option value="">Selecione uma categoria</option></select></div>
          <div class="field"><label class="label" for="cover">Imagem de capa 16:9</label><input class="control" id="cover" type="file" accept="image/png,image/jpeg,image/webp" /><div class="hint">PNG, JPEG ou WebP, até 5 MB. A capa é enviada somente ao salvar ou publicar.</div></div>

          <div class="field"><label class="label" for="coverAlt">Texto alternativo da capa</label><input class="control" id="coverAlt" type="text" maxlength="500" /></div>
          <div class="field">
            <label class="label">Conteúdo do artigo</label>
            <div class="tabs"><button class="tab active" id="htmlTab" type="button">HTML</button><button class="tab" id="previewTab" type="button">Visualizar</button></div>
            <div id="htmlPanel"><textarea class="control html-editor" id="htmlContent" spellcheck="false" placeholder="Cole aqui o HTML gerado pela IA…"></textarea></div>
            <div class="preview-shell" id="previewPanel"><div class="preview-top">Prévia — não salva nem publicada</div><article class="preview-frame" id="previewFrame"><div class="empty-preview">Cole o HTML e clique em Visualizar.</div></article></div>
          </div>

          <div class="message" id="message">Prévia gerada localmente. Nada foi publicado.</div>
        </section>

        <aside class="panel">
          <div class="status" id="editorStatus">Rascunho local</div>
          <h2 class="side-title" style="margin-top:20px">Exibição</h2>
          <label class="check"><input id="homeFeatured" type="checkbox" /><span><strong>Destaque principal da Home</strong><br><span class="muted">Usar este artigo como principal.</span></span></label>
          <label class="check"><input id="highlights" type="checkbox" /><span><strong>Em Destaque</strong><br><span class="muted">Incluir na faixa de destaques.</span></span></label>
          <label class="check"><input id="cienciaVital" type="checkbox" /><span><strong>Ciência Vital</strong><br><span class="muted">Marcar como parte da série.</span></span></label>
          <div class="actions"><button class="btn btn-outline" id="visualizeSide" type="button">Visualizar artigo</button><button class="btn btn-secondary" id="saveDraft" type="button" disabled>Salvar rascunho</button><button class="btn btn-primary" id="publish" type="button" disabled>Publicar</button><button class="btn btn-outline" id="unpublish" type="button" hidden disabled>Despublicar</button><button class="btn btn-outline" id="deleteArticle" type="button" hidden disabled>Excluir artigo</button></div>
          <div class="safe-note">Visualizar não salva nem publica. Salvar rascunho mantém o conteúdo fora do site. Publicar inicia a atualização do site.</div>
        </aside>
      </div>
    </main>

    <script>import '../../lib/admin-editor.js';</script>
  </body>
</html>

