<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="robots" content="noindex,nofollow" />
    <title>VitaCerta Admin</title>
    <style>
      :root { --bg:#f4f6f4; --panel:#fff; --text:#1f2f28; --muted:#66736d; --line:#dfe6e1; --brand:#245640; --soft:#e8f0eb; }
      * { box-sizing:border-box; }
      body { margin:0; font-family:Inter,ui-sans-serif,system-ui,-apple-system,BlinkMacSystemFont,"Segoe UI",sans-serif; background:var(--bg); color:var(--text); }
      button,input,select { font:inherit; }
      .topbar { position:sticky; top:0; z-index:5; background:var(--panel); border-bottom:1px solid var(--line); }
      .topbar-inner,.main { max-width:1180px; margin:auto; padding-left:22px; padding-right:22px; }
      .topbar-inner { min-height:72px; display:flex; align-items:center; justify-content:space-between; gap:16px; }
      .brand { font-size:22px; font-weight:800; letter-spacing:-.03em; }
      .brand small { margin-left:8px; color:var(--muted); font-size:14px; font-weight:500; }
      .btn { border:0; border-radius:10px; padding:11px 15px; font-weight:700; cursor:pointer; text-decoration:none; display:inline-block; }
      .btn-primary { background:var(--brand); color:#fff; }
      .btn-secondary { background:#eef2ef; color:var(--text); }
      .main { padding-top:34px; padding-bottom:56px; }
      .heading { display:flex; align-items:flex-end; justify-content:space-between; gap:18px; margin-bottom:24px; }
      h1 { margin:0 0 6px; font-size:clamp(28px,4vw,38px); letter-spacing:-.04em; }
      .subtitle,.note { color:var(--muted); }
      .count { padding:9px 13px; border-radius:999px; background:var(--soft); color:var(--brand); font-weight:800; white-space:nowrap; }
      .panel { background:var(--panel); border:1px solid var(--line); border-radius:14px; overflow:hidden; }
      .filters { display:grid; grid-template-columns:minmax(0,1fr) 220px 180px; gap:12px; padding:18px; border-bottom:1px solid var(--line); }
      .control { width:100%; border:1px solid #cfd9d2; border-radius:10px; background:#fff; padding:11px 12px; }
      .table-wrap { overflow-x:auto; }
      table { width:100%; min-width:860px; border-collapse:collapse; }
      th,td { padding:15px 18px; text-align:left; border-bottom:1px solid #edf1ee; vertical-align:middle; }
      th { background:#fbfcfb; color:var(--muted); font-size:12px; text-transform:uppercase; letter-spacing:.06em; }
      .article-title { font-weight:750; line-height:1.35; margin-bottom:5px; }
      .slug { color:var(--muted); font-size:12px; overflow-wrap:anywhere; }
      .badge { display:inline-flex; align-items:center; gap:6px; border-radius:999px; padding:6px 9px; font-size:12px; font-weight:750; background:#edf5ef; color:#28573c; }
      .dot { width:7px; height:7px; border-radius:50%; background:#3d8b5c; }
      .flags { display:flex; flex-wrap:wrap; gap:5px; margin-top:6px; }
      .flag { padding:3px 6px; border-radius:6px; background:#f1f3f1; color:#53605a; font-size:11px; }
      .link { display:inline-block; padding:8px 10px; border:1px solid #cdd9d1; border-radius:8px; color:var(--brand); font-weight:750; text-decoration:none; }
      .empty { display:none; padding:44px 20px; text-align:center; color:var(--muted); }
      .note { margin-top:14px; font-size:13px; }
      @media(max-width:760px){ .topbar-inner,.main{padding-left:14px;padding-right:14px}.topbar-inner{min-height:64px}.brand small{display:none}.heading{align-items:flex-start;flex-direction:column}.filters{grid-template-columns:1fr}.btn-secondary{display:none} }
    </style>
  </head>
  <body>
    <header class="topbar">
      <div class="topbar-inner">
        <div class="brand">VitaCerta <small>Admin</small></div>
        <div>
          <button class="btn btn-secondary" id="logout" type="button">Sair</button>
          <a class="btn btn-primary" href="/admin/novo/">+ Novo artigo</a>
        </div>
      </div>
    </header>

    <main class="main">
      <div class="heading">
        <div>
          <h1>Artigos</h1>
          <p class="subtitle">Gerencie o conteúdo editorial do VitaCerta em uma tela simples.</p>
        </div>
        <div class="count"><span id="visibleCount">0</span> artigos</div>
      </div>

      <section class="panel">
        <div class="filters">
          <input class="control" id="search" type="search" placeholder="Buscar por título ou slug…" aria-label="Buscar artigos" />
          <select class="control" id="category" aria-label="Filtrar por categoria">
            <option value="">Todas as categorias</option>

          </select>
          <select class="control" id="status" aria-label="Filtrar por status">
            <option value="">Todos os status</option>
            <option value="published">Publicado</option><option value="draft">Rascunho</option>
          </select>
        </div>

        <div class="table-wrap">
          <table>
            <thead><tr><th>Artigo</th><th>Categoria</th><th>Status</th><th>Atualizado</th><th>Ação</th></tr></thead>
            <tbody id="articleRows">
            </tbody>
          </table>
        </div>
        <div class="empty" id="emptyState">Nenhum artigo encontrado com esses filtros.</div>
      </section>
      <p class="note">Carregando artigos…</p>
    </main>

    <script>import '../../lib/admin-list.js';</script>
  </body>
</html>
