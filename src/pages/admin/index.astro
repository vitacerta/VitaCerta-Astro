---
import { client } from '../../lib/sanity.js';

const articles = await client.fetch(`
  *[_type == "post"] | order(_updatedAt desc){
    _id,
    title,
    "slug": slug.current,
    _updatedAt,
    publishedAt,
    "category": categories[0]->title,
    isHomeFeatured,
    showInHighlights,
    isCienciaVital
  }
`);

const categories = [...new Set(articles.map((article) => article.category).filter(Boolean))].sort((a, b) => a.localeCompare(b, 'pt-BR'));

const formatDate = (value) => {
  if (!value) return '—';
  return new Intl.DateTimeFormat('pt-BR', {
    day: '2-digit',
    month: '2-digit',
    year: 'numeric',
  }).format(new Date(value));
};
---

<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="robots" content="noindex,nofollow" />
    <title>VitaCerta Admin</title>
    <style>
      :root {
        color-scheme: light;
        --bg: #f4f6f4;
        --panel: #ffffff;
        --text: #1f2f28;
        --muted: #66736d;
        --line: #dfe6e1;
        --brand: #245640;
        --brand-soft: #e8f0eb;
        --danger: #8b2d2d;
        --radius: 14px;
      }

      * { box-sizing: border-box; }
      body {
        margin: 0;
        font-family: Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
        background: var(--bg);
        color: var(--text);
      }
      button, input, select { font: inherit; }
      .shell { min-height: 100vh; }
      .topbar {
        background: var(--panel);
        border-bottom: 1px solid var(--line);
        position: sticky;
        top: 0;
        z-index: 5;
      }
      .topbar-inner {
        max-width: 1180px;
        margin: 0 auto;
        min-height: 72px;
        padding: 0 22px;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 16px;
      }
      .brand-wrap { display: flex; align-items: baseline; gap: 10px; }
      .brand { font-weight: 800; letter-spacing: -0.03em; font-size: 22px; }
      .admin-label { color: var(--muted); font-size: 14px; }
      .actions { display: flex; gap: 10px; }
      .btn {
        border: 0;
        border-radius: 10px;
        padding: 11px 15px;
        cursor: pointer;
        font-weight: 700;
      }
      .btn-primary { background: var(--brand); color: #fff; }
      .btn-secondary { background: #eef2ef; color: var(--text); }
      main { max-width: 1180px; margin: 0 auto; padding: 34px 22px 56px; }
      .heading-row {
        display: flex;
        align-items: flex-end;
        justify-content: space-between;
        gap: 18px;
        margin-bottom: 24px;
      }
      h1 { margin: 0 0 6px; font-size: clamp(28px, 4vw, 38px); letter-spacing: -0.04em; }
      .subtitle { margin: 0; color: var(--muted); }
      .count-card {
        background: var(--brand-soft);
        color: var(--brand);
        border-radius: 999px;
        padding: 9px 13px;
        font-weight: 800;
        white-space: nowrap;
      }
      .panel {
        background: var(--panel);
        border: 1px solid var(--line);
        border-radius: var(--radius);
        overflow: hidden;
      }
      .filters {
        padding: 18px;
        display: grid;
        grid-template-columns: minmax(0, 1fr) 220px 180px;
        gap: 12px;
        border-bottom: 1px solid var(--line);
      }
      .control {
        width: 100%;
        border: 1px solid #cfd9d2;
        background: #fff;
        border-radius: 10px;
        padding: 11px 12px;
        outline: none;
      }
      .control:focus { border-color: var(--brand); box-shadow: 0 0 0 3px rgba(36, 86, 64, .1); }
      .table-wrap { overflow-x: auto; }
      table { width: 100%; border-collapse: collapse; min-width: 860px; }
      th, td { padding: 15px 18px; text-align: left; border-bottom: 1px solid #edf1ee; vertical-align: middle; }
      th { color: var(--muted); font-size: 12px; text-transform: uppercase; letter-spacing: .06em; background: #fbfcfb; }
      tbody tr:hover { background: #fafcfb; }
      .title-cell { max-width: 470px; }
      .article-title { font-weight: 750; line-height: 1.35; margin-bottom: 5px; }
      .slug { color: var(--muted); font-size: 12px; overflow-wrap: anywhere; }
      .badge {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        border-radius: 999px;
        padding: 6px 9px;
        font-size: 12px;
        font-weight: 750;
        background: #edf5ef;
        color: #28573c;
      }
      .dot { width: 7px; height: 7px; background: #3d8b5c; border-radius: 50%; }
      .flags { display: flex; gap: 5px; flex-wrap: wrap; margin-top: 6px; }
      .flag { font-size: 11px; padding: 3px 6px; border-radius: 6px; background: #f1f3f1; color: #53605a; }
      .link-button {
        color: var(--brand);
        font-weight: 750;
        text-decoration: none;
        border: 1px solid #cdd9d1;
        border-radius: 8px;
        padding: 8px 10px;
        display: inline-block;
      }
      .empty { padding: 44px 20px; text-align: center; color: var(--muted); display: none; }
      .mvp-note { margin-top: 14px; color: var(--muted); font-size: 13px; }

      dialog {
        border: 0;
        border-radius: 16px;
        max-width: 520px;
        width: calc(100% - 32px);
        padding: 0;
        box-shadow: 0 24px 80px rgba(0,0,0,.2);
      }
      dialog::backdrop { background: rgba(19, 31, 25, .45); }
      .dialog-body { padding: 26px; }
      .dialog-body h2 { margin: 0 0 8px; }
      .dialog-body p { color: var(--muted); line-height: 1.55; }
      .dialog-footer { padding: 16px 26px 24px; display: flex; justify-content: flex-end; }

      @media (max-width: 760px) {
        .topbar-inner { min-height: 64px; padding: 0 16px; }
        .admin-label { display: none; }
        main { padding: 24px 14px 40px; }
        .heading-row { align-items: flex-start; flex-direction: column; }
        .filters { grid-template-columns: 1fr; }
        .actions .btn-secondary { display: none; }
      }
    </style>
  </head>
  <body>
    <div class="shell">
      <header class="topbar">
        <div class="topbar-inner">
          <div class="brand-wrap">
            <div class="brand">VitaCerta</div>
            <div class="admin-label">Admin</div>
          </div>
          <div class="actions">
            <button class="btn btn-secondary" type="button">Sair</button>
            <button class="btn btn-primary" id="newArticleButton" type="button">+ Novo artigo</button>
          </div>
        </div>
      </header>

      <main>
        <div class="heading-row">
          <div>
            <h1>Artigos</h1>
            <p class="subtitle">Gerencie o conteúdo editorial do VitaCerta em uma tela simples.</p>
          </div>
          <div class="count-card"><span id="visibleCount">{articles.length}</span> artigos</div>
        </div>

        <section class="panel">
          <div class="filters">
            <input class="control" id="search" type="search" placeholder="Buscar por título ou slug…" aria-label="Buscar artigos" />
            <select class="control" id="category" aria-label="Filtrar por categoria">
              <option value="">Todas as categorias</option>
              {categories.map((category) => <option value={category}>{category}</option>)}
            </select>
            <select class="control" id="status" aria-label="Filtrar por status">
              <option value="">Todos os status</option>
              <option value="published">Publicado</option>
            </select>
          </div>

          <div class="table-wrap">
            <table>
              <thead>
                <tr>
                  <th>Artigo</th>
                  <th>Categoria</th>
                  <th>Status</th>
                  <th>Atualizado</th>
                  <th>Ação</th>
                </tr>
              </thead>
              <tbody id="articleRows">
                {articles.map((article) => (
                  <tr data-title={(article.title || '').toLowerCase()} data-slug={(article.slug || '').toLowerCase()} data-category={article.category || ''} data-status="published">
                    <td class="title-cell">
                      <div class="article-title">{article.title}</div>
                      <div class="slug">/{article.slug || 'sem-slug'}</div>
                      <div class="flags">
                        {article.isHomeFeatured && <span class="flag">Home</span>}
                        {article.showInHighlights && <span class="flag">Em Destaque</span>}
                        {article.isCienciaVital && <span class="flag">Ciência Vital</span>}
                      </div>
                    </td>
                    <td>{article.category || '—'}</td>
                    <td><span class="badge"><span class="dot"></span>Publicado</span></td>
                    <td>{formatDate(article._updatedAt || article.publishedAt)}</td>
                    <td><a class="link-button" href={article.slug ? `/conteudos/${article.slug}/` : '#'} target="_blank">Ver artigo</a></td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
          <div class="empty" id="emptyState">Nenhum artigo encontrado com esses filtros.</div>
        </section>

        <p class="mvp-note">Protótipo do Admin MVP. Nesta primeira etapa a listagem usa apenas conteúdo publicado. Rascunhos, edição e publicação entram pela camada segura do Admin nos próximos blocos.</p>
      </main>
    </div>

    <dialog id="newArticleDialog">
      <div class="dialog-body">
        <h2>Novo artigo</h2>
        <p>O botão já faz parte da interface do Admin. O formulário com HTML, visualização, rascunho e publicação será conectado no próximo bloco, através da camada segura do VitaCerta.</p>
      </div>
      <div class="dialog-footer">
        <button class="btn btn-primary" id="closeDialog" type="button">Entendi</button>
      </div>
    </dialog>

    <script>
      const search = document.querySelector('#search');
      const category = document.querySelector('#category');
      const status = document.querySelector('#status');
      const rows = [...document.querySelectorAll('#articleRows tr')];
      const visibleCount = document.querySelector('#visibleCount');
      const emptyState = document.querySelector('#emptyState');
      const dialog = document.querySelector('#newArticleDialog');
      const newButton = document.querySelector('#newArticleButton');
      const closeDialog = document.querySelector('#closeDialog');

      const applyFilters = () => {
        const q = search.value.trim().toLowerCase();
        const selectedCategory = category.value;
        const selectedStatus = status.value;
        let count = 0;

        rows.forEach((row) => {
          const matchesText = !q || row.dataset.title.includes(q) || row.dataset.slug.includes(q);
          const matchesCategory = !selectedCategory || row.dataset.category === selectedCategory;
          const matchesStatus = !selectedStatus || row.dataset.status === selectedStatus;
          const visible = matchesText && matchesCategory && matchesStatus;
          row.hidden = !visible;
          if (visible) count += 1;
        });

        visibleCount.textContent = String(count);
        emptyState.style.display = count === 0 ? 'block' : 'none';
      };

      search.addEventListener('input', applyFilters);
      category.addEventListener('change', applyFilters);
      status.addEventListener('change', applyFilters);
      newButton.addEventListener('click', () => dialog.showModal());
      closeDialog.addEventListener('click', () => dialog.close());
    </script>
  </body>
</html>
