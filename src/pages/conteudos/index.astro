---
import { getCollection } from "astro:content";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import Card from "@/components/Card.astro";
import { getSortedPosts } from "@/utils/getSortedPosts";

const posts = getSortedPosts(await getCollection("posts")).filter(
  post => post.data.category
);
---

<Layout
  title="Conteúdos | VitaCerta"
  description="Explore todos os conteúdos do VitaCerta sobre saúde, nutrição, movimento, mente e longevidade."
>
  <Header />
  <main id="main-content" class="app-layout py-10 sm:py-14" data-pagefind-body>
    <header class="border-border border-b pb-8">
      <p class="editorial-kicker">Biblioteca VitaCerta</p>
      <h1 class="font-editorial mt-3 text-4xl font-semibold sm:text-5xl">
        Todos os conteúdos
      </h1>
      <p class="text-muted-foreground mt-4 max-w-2xl text-lg leading-8">
        Guias, explicações e artigos organizados para facilitar a busca por informações úteis para a vida real.
      </p>
    </header>

    {
      posts.length > 0 ? (
        <ul class="mt-8 grid gap-4 md:grid-cols-2">
          {posts.map(post => <Card variant="h3" {...post} />)}
        </ul>
      ) : (
        <div class="editorial-card mt-8 max-w-2xl">
          <h2 class="font-editorial text-2xl font-semibold">Acervo em migração</h2>
          <p class="text-muted-foreground mt-2 leading-7">
            Os artigos do VitaCerta serão incorporados aqui após a validação técnica da nova estrutura.
          </p>
        </div>
      )
    }
  </main>
  <Footer />
</Layout>
