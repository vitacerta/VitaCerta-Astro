---
import Image from "astro/components/Image.astro";
import Layout from "../../layouts/Base.astro";
import { client } from "../../lib/sanity";
import PostCardBase from "../../components/PostCardBase.astro";
import PortableComponent from "../../components/builder/PortableComponent.astro";
import { formatDate } from "../../utils/dateFormatter";
import "../../styles/article.css";

export async function getStaticPaths() {
  const locale = "pt-BR";
  const posts = await client.fetch(
    `
    *[_type == "post" && language == $lang]{
      title,
      description,
      bodyHtml,
      body,
      legacyBodyHtml,
      publishedAt,
      editoriallyUpdatedAt,
      _createdAt,
      language,
      canonicalURL,
      "slug": slug.current,
      "image": coalesce(thumbnail.asset->url, mainImage.asset->url, coverUrl),
      "categoryId": categories[0]->_id,
      "categories": categories[0]->{
        "title": title[_key == $lang][0].value,
        "slug": slug.current
      }
    }
    `,
    { lang: locale },
  );

  return posts.map((post) => ({
    params: { slug: post.slug },
    props: { post },
  }));
}

const locale = "pt-BR";
const { post } = Astro.props;
const displayDate = post.publishedAt || post._createdAt;
const canonicalURL = post.canonicalURL || `https://vitacerta.com.br/conteudos/${post.slug}/`;
const encodedURL = encodeURIComponent(canonicalURL);
const encodedShareText = encodeURIComponent(`${post.title} ${canonicalURL}`);

const normalizeLegacyInternalLinks = (html = "") => html
  .replace(
    /https?:\/\/(?:www\.)?vitacerta\.com\.br\/pt-BR\/blog\/([a-z0-9-]+)\/?/gi,
    "/conteudos/$1/",
  )
  .replace(
    /\/pt-BR\/blog\/([a-z0-9-]+)\/?/gi,
    "/conteudos/$1/",
  );

const editorialBodyHtml = normalizeLegacyInternalLinks(post.bodyHtml || "");
const legacyBodyHtml = normalizeLegacyInternalLinks(post.legacyBodyHtml || "");
const portableText = Array.isArray(post.body)
  ? post.body
      .flatMap((block) => Array.isArray(block?.children) ? block.children : [])
      .map((child) => child?.text || "")
      .join(" ")
  : "";
const readableText = `${post.title || ""} ${post.description || ""} ${editorialBodyHtml || legacyBodyHtml}`
  .replace(/<[^>]*>/g, " ")
  .replace(/&[a-z0-9#]+;/gi, " ")
  .concat(` ${portableText}`)
  .replace(/\s+/g, " ")
  .trim();
const readingMinutes = Math.max(2, Math.ceil(readableText.split(" ").filter(Boolean).length / 220));

const relatedProjection = `{
  title,
  description,
  "date": coalesce(publishedAt, _createdAt),
  "slug": slug.current,
  "image": coalesce(thumbnail.asset->url, mainImage.asset->url, coverUrl),
  "categories": categories[0]->{
    "title": title[_key == $lang][0].value,
    "slug": slug.current
  }
}`;

let relatedPosts = [];

if (post.categoryId) {
  relatedPosts = await client.fetch(
    `
    *[_type == "post" && language == $lang && slug.current != $currentSlug && references($categoryId)]
    | order(publishedAt desc, _createdAt desc)[0...3]${relatedProjection}
    `,
    { lang: locale, currentSlug: post.slug, categoryId: post.categoryId },
  );
}

if (relatedPosts.length < 3) {
  const excludedSlugs = [post.slug, ...relatedPosts.map((item) => item.slug)];
  const fallbackPosts = await client.fetch(
    `
    *[_type == "post" && language == $lang && !(slug.current in $excludedSlugs)]
    | order(publishedAt desc, _createdAt desc)[0...$remaining]${relatedProjection}
    `,
    {
      lang: locale,
      excludedSlugs,
      remaining: 3 - relatedPosts.length,
    },
  );
  relatedPosts = [...relatedPosts, ...fallbackPosts];
}
---

<Layout
  title={post.title}
  description={post.description}
  image={post.image}
  canonicalURL={canonicalURL}
  lang={post.language || locale}
>
  <article class="editorial-article">
    <nav class="article-breadcrumb" aria-label="Caminho da página">
      <div class="article-shell breadcrumb-inner">
        <a href="/">Início</a><span aria-hidden="true">›</span>
        <a href="/conteudos/">Conteúdos</a>
        {post.categories && <><span aria-hidden="true">›</span><span>{post.categories.title}</span></>}
      </div>
    </nav>

    <div class="article-shell article-layout">
      <div class="article-main">
        {post.categories && (
          <a class="article-kicker" href={`/${locale}/blog/${post.categories.slug}/`}>
            {post.categories.title}
          </a>
        )}
        <h1>{post.title}</h1>
        <p class="article-dek">{post.description}</p>

        <div class="editorial-byline">
          <span class="editorial-icon" aria-hidden="true">✦</span>
          <p>
            Conteúdo produzido pelo <a href="/sobre/"><strong>VitaCerta Editorial</strong></a>
            com base nas fontes apresentadas no artigo.
          </p>
        </div>

        <div class="article-dates">
          <span>Publicado em {formatDate(displayDate)}</span>
          {post.editoriallyUpdatedAt && <span>Atualizado em {formatDate(post.editoriallyUpdatedAt)}</span>}
          <span>Leitura de {readingMinutes} minutos</span>
        </div>

        {post.image && (
          <figure class="article-cover">
            <Image
              src={post.image}
              alt={post.title}
              width="1600"
              height="900"
              format="webp"
              fetchpriority="high"
              quality={62}
              loading="eager"
            />
          </figure>
        )}

        <div class="editorial-copy" data-article-copy>
          {editorialBodyHtml ? (
            <div class="post" set:html={editorialBodyHtml}></div>
          ) : post.body ? (
            <div class="post"><PortableComponent body={post.body} /></div>
          ) : legacyBodyHtml ? (
            <div class="post" set:html={legacyBodyHtml}></div>
          ) : null}
        </div>

        <div class="article-disclaimer">
          <span class="editorial-icon" aria-hidden="true">i</span>
          <p>Conteúdo educativo. Não substitui orientação, diagnóstico ou tratamento realizado por profissionais de saúde.</p>
        </div>

        <div class="article-share">
          <strong>Compartilhar</strong>
          <div class="share-actions">
            <a href={`https://wa.me/?text=${encodedShareText}`} target="_blank" rel="noopener noreferrer">WhatsApp</a>
            <a href={`https://www.facebook.com/sharer/sharer.php?u=${encodedURL}`} target="_blank" rel="noopener noreferrer">Facebook</a>
            <button type="button" class="js-copy-link" data-url={canonicalURL}>Copiar link</button>
          </div>
        </div>
      </div>

      <aside class="article-sidebar" aria-label="Informações editoriais">
        <section class="editorial-card primary-card">
          <span class="card-eyebrow">Transparência</span>
          <h2>Como produzimos nossos conteúdos</h2>
          <p>Conheça o propósito do VitaCerta, o compromisso com fontes confiáveis e os limites de nossos conteúdos.</p>
          <a href="/sobre/">Conhecer o VitaCerta <span aria-hidden="true">→</span></a>
        </section>

        <section class="editorial-card article-summary" data-article-summary hidden>
          <span class="card-eyebrow">Neste artigo</span>
          <h2>Em resumo</h2>
          <ol data-summary-list></ol>
        </section>
      </aside>
    </div>
  </article>

  {relatedPosts.length > 0 && (
    <section class="related-reading">
      <div class="container">
        <div class="related-heading">
          <div>
            <span>Continue explorando</span>
            <h2>Conteúdos relacionados</h2>
          </div>
          <a href="/conteudos/">Ver todos <span aria-hidden="true">→</span></a>
        </div>
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3">
          {relatedPosts.map((post) => <PostCardBase {...post} />)}
        </div>
      </div>
    </section>
  )}

  <script is:inline>
    document.querySelectorAll('.js-copy-link').forEach((button) => {
      button.addEventListener('click', async () => {
        const url = button.getAttribute('data-url');
        if (!url) return;

        try {
          await navigator.clipboard.writeText(url);
          const originalText = button.textContent;
          button.textContent = 'Link copiado';
          setTimeout(() => {
            button.textContent = originalText;
          }, 1800);
        } catch (error) {
          window.prompt('Copie o link:', url);
        }
      });
    });

    const copy = document.querySelector('[data-article-copy]');
    const summary = document.querySelector('[data-article-summary]');
    const summaryList = document.querySelector('[data-summary-list]');
    const headings = copy ? [...copy.querySelectorAll('h2')].slice(0, 6) : [];

    if (summary && summaryList && headings.length > 1) {
      headings.forEach((heading, index) => {
        if (!heading.id) heading.id = `secao-${index + 1}`;
        const item = document.createElement('li');
        const link = document.createElement('a');
        link.href = `#${heading.id}`;
        link.textContent = heading.textContent || `Seção ${index + 1}`;
        item.appendChild(link);
        summaryList.appendChild(item);
      });
      summary.hidden = false;
    }
  </script>
</Layout>

