---
import Image from "astro/components/Image.astro";
import Layout from "../../layouts/Base.astro";
import { client } from "../../lib/sanity";
import PostCardBase from "../../components/PostCardBase.astro";
import PortableComponent from "../../components/builder/PortableComponent.astro";
import { formatDate } from "../../utils/dateFormatter";

export async function getStaticPaths() {
  const locale = "pt-BR";
  const posts = await client.fetch(
    `
    *[_type == "post" && language == $lang]{
      title,
      description,
      duration,
      body,
      legacyBodyHtml,
      publishedAt,
      _createdAt,
      language,
      canonicalURL,
      "slug": slug.current,
      "image": coalesce(mainImage.asset->url, thumbnail.asset->url, coverUrl),
      "author": author->{name, "slug": slug.current, "image": image.asset->url},
      "categories": categories[0]->{
        "title": title[_key == $lang][0].value,
        "slug": slug.current
      }
    }
    `,
    { lang: locale },
  );

  return posts.map((post) => ({
    params: { slug: post.slug },
    props: { post },
  }));
}

const locale = "pt-BR";
const { post } = Astro.props;
const displayDate = post.publishedAt || post._createdAt;
const canonicalURL = post.canonicalURL || `https://vitacerta.com.br/conteudos/${post.slug}/`;

const relatedPosts = await client.fetch(
  `
  *[_type == "post" && language == $lang && slug.current != $currentSlug]
  | order(publishedAt desc, _createdAt desc)[0...3]{
    title,
    description,
    duration,
    "date": coalesce(publishedAt, _createdAt),
    "slug": slug.current,
    "image": coalesce(thumbnail.asset->url, mainImage.asset->url, coverUrl),
    "author": author->{name, "slug": slug.current},
    "categories": categories[0]->{
      "title": title[_key == $lang][0].value,
      "slug": slug.current
    }
  }
  `,
  { lang: locale, currentSlug: post.slug },
);

const socials = [
  {url: "#", title: "Instagram", icon: "fa-brands fa-instagram"},
  {url: "#", title: "Twitter", icon: "fa-brands fa-x-twitter"},
  {url: "#", title: "Youtube", icon: "fa-brands fa-youtube"},
];
---

<Layout
  title={post.title}
  description={post.description}
  image={post.image}
  canonicalURL={canonicalURL}
  lang={post.language || locale}
>
  <section class="mt-10">
    <div class="container">
      <div class="flex itms-center justify-between flex-wrap gap-4">
        <a href={`/${locale}/blog`} class="btn btn-link text-inherit uppercase no-underline group p-0">
          <i class="fa-solid fa-arrow-left group-hover:translate-x-1"></i> Voltar
        </a>
        <p class="font-semibold text-3xl uppercase">VitaCerta</p>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="grid grid-cols-1 md:grid-cols-2 gap-10 mb-10">
        <h1>{post.title}</h1>
        <p class="text-lg font-semibold">{post.description}</p>
      </div>
      <div>
        <div class="flex flex-wrap gap-x-6 gap-y-3 justify-between items-center mb-5">
          {post.author && <p><b class="mr-2">Texto</b><a href={`/${locale}/authors/${post.author.slug}`}>{post.author.name}</a></p>}
          <p><b class="mr-2">Data</b><span>{formatDate(displayDate)}</span></p>
          {post.duration != null && <p><b class="mr-2">Leitura</b><span>{post.duration} min</span></p>}
          {post.categories && (
            <a href={`/${locale}/blog/${post.categories.slug}`} class="ml-auto btn btn-outline rounded-full py-1 px-4 h-auto hover:bg-black hover:text-white">
              {post.categories.title}
            </a>
          )}
        </div>
        {post.image && (
          <Image src={post.image} alt={post.title} width="1200" height="600" format="webp" fetchpriority="high" quality={45} loading="eager" class="aspect-2/1 w-full h-auto object-cover" />
        )}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="max-w-6xl mx-auto grid grid-cols-1 lg:grid-cols-[350px_1fr] gap-x-20 gap-y-10">
        <aside>
          {post.author && post.author.image && (
            <a href={`/${locale}/authors/${post.author.slug}`} class="text-2xl md:text-4xl font-semibold grid grid-cols-[80px_1fr] gap-4 items-center">
              <Image src={post.author.image} alt={post.author.name} width="80" height="80" format="webp" class="rounded-full h-auto mx-auto" />
              {post.author.name}
            </a>
          )}
          <div class="grid gap-4 border-t pt-5 mt-8">
            <div class="grid grid-cols-[1fr_auto] gap-2"><b>Data</b><span>{formatDate(displayDate)}</span></div>
            {post.duration != null && <div class="grid grid-cols-[1fr_auto] gap-2"><b>Leitura</b><span>{post.duration} min</span></div>}
            <div class="grid grid-cols-[1fr_auto] gap-2">
              <b>Compartilhar</b>
              <nav class="flex items-center gap-3 flex-wrap">
                {socials.map((icon) => <a href={icon.url} title={icon.title} class="hover:rotate-12" target="_blank" rel="noopener noreferrer"><i class={icon.icon} /></a>)}
              </nav>
            </div>
          </div>
        </aside>

        {post.body ? (
          <div class="post"><PortableComponent body={post.body} /></div>
        ) : post.legacyBodyHtml ? (
          <div class="post" set:html={post.legacyBodyHtml}></div>
        ) : null}
      </div>
    </div>
  </section>

  {relatedPosts.length > 0 && (
    <section class="section">
      <div class="container">
        <div class="border-t pt-10">
          <div class="flex flex-wrap gap-4 justify-between items-center">
            <h2 class="uppercase">Artigos recentes</h2>
            <a href={`/${locale}/blog`} class="btn btn-link text-inherit uppercase no-underline group p-0">Ver todos <i class="fa-solid fa-arrow-right group-hover:translate-x-1" /></a>
          </div>
          <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 mt-10">
            {relatedPosts.map((post) => <PostCardBase {...post} />)}
          </div>
        </div>
      </div>
    </section>
  )}
</Layout>
