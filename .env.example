# VitaCerta — exemplo de configuração
# Nunca coloque valores reais de tokens ou senhas neste arquivo.

# Site público
PUBLIC_SANITY_PROJECT_ID=your_sanity_project_id
PUBLIC_SANITY_DATASET=production

# Admin / camada segura
SANITY_PROJECT_ID=your_sanity_project_id
SANITY_DATASET=production
SANITY_WRITE_TOKEN=replace_with_secret_in_runtime
ADMIN_ALLOWED_ORIGIN=https://admin.example.com

# GitHub / automação, quando aplicável
GITHUB_REPOSITORY=owner/repository
GITHUB_DISPATCH_EVENT=sanity-publish

# Cloudflare Worker
# Secrets devem ser cadastrados no painel/CLI do Cloudflare e não versionados.
